{
  "name": "examcraft",
  "version": "0.1.0",
  "description": "An offline-first subject IDE for deliberate exam practice",
  "private": true,
  "license": "GPL-3.0-only",
  "type": "module",
  "main": "dist-electron/main.cjs",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite --host 127.0.0.1",
    "build": "npm run typecheck && vite build && node scripts/build.mjs",
    "start": "node scripts/start.mjs",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "npm run build && playwright test",
    "check": "npm run typecheck && npm test && npm run build",
    "mcp": "node dist-mcp/server.cjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.0",
    "electron": "44.7.0",
    "esbuild": "^0.28.2",
    "prettier": "3.9.10",
    "typescript": "~5.9.3",
    "vite": "8.3.4",
    "vitest": "^4.0.18"
  }
}
